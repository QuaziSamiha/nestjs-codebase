//* ─────────────────────────────────────────────────────────────────────────
//* RATE LIMITING — SEE src/common/throttler AND docs/concepts/rate-limiting.md
//*
//* 0 = NO REVERSE PROXY. THIS ENVIRONMENT IS REACHED AS http://192.168.0.211:4036
//* AND http://202.51.176.30:4035 — THE NODE PROCESS'S OWN PORT, DIRECTLY, WITH NO
//* TLS TERMINATOR IN FRONT OF IT. req.ip IS THEREFORE THE RAW SOCKET ADDRESS,
//* WHICH IS THE CORRECT BUCKET KEY HERE.
//*
//* A NAT / ROUTER PORT-FORWARD IS NOT A PROXY HOP — IT REWRITES ADDRESSES BUT
//* SETS NO X-Forwarded-For — SO THE PUBLIC-IP ENTRY POINT DOES NOT MAKE THIS 1.
//* PUTTING A REAL nginx IN FRONT OF THIS BOX LATER DOES: BUMP IT TO 1 THEN, AND
//* AppThrottlerGuard WILL WARN ON THE FIRST FORWARDED REQUEST IF IT IS FORGOTTEN.
//*
//* HELD EXPLICIT RATHER THAN LEFT TO THE SCHEMA DEFAULT SO THAT "0 HERE" READS AS
//* A VERIFIED TOPOLOGY FACT AND NOT AS A VAR SOMEBODY NEVER GOT ROUND TO SETTING.
//* ─────────────────────────────────────────────────────────────────────────
THROTTLE_TRUST_PROXY_HOPS=0

//* EMERGENCY KILL SWITCH — SET false AND RESTART TO DISABLE RATE LIMITING ON
//* EVERY ROUTE. NOTE §7.5 OF THE DOC: THE OFFICE ADMIN TOOLS DO BULK OPERATIONS,
//* SO THIS IS THE ENVIRONMENT MOST LIKELY TO TRIP LIMITS CALIBRATED ON STOREFRONT
//* TRAFFIC. IF THAT HAPPENS, RAISE THE TIERS BELOW — DON'T REACH FOR THE SWITCH.
THROTTLE_ENABLED=true

//* GLOBAL TIERS — AT THE SCHEMA DEFAULTS IN src/common/throttler/config/throttler.env.ts.
# THROTTLE_SHORT_TTL_MS=10000
# THROTTLE_SHORT_LIMIT=30
# THROTTLE_LONG_TTL_MS=60000
# THROTTLE_LONG_LIMIT=200

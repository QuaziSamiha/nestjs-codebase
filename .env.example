# //* ─────────────────────────────────────────────────────────────────────────
# //* COPY TO .env.development (OR .env.development.local / .env.production)
# //* AND FILL IN REAL VALUES. NEVER COMMIT THE FILLED-IN COPIES.
# //* SEE docs/ENV_FILE.md FOR WHAT EACH VARIABLE DOES.
# //* ─────────────────────────────────────────────────────────────────────────

# //* DATABASE
DATABASE_URL="postgres://postgres:postgres@localhost:5432/app_db?schema=public"
# DATABASE_POOL_MAX=10
# DATABASE_POOL_IDLE_TIMEOUT_MS=10000
# DATABASE_POOL_CONNECTION_TIMEOUT_MS=0

# //* APPLICATION
NODE_ENV=development
APP_NAME="My App"
PORT=5001
API_PREFIX=api/v1
BASE_URL=http://localhost:5001
ALLOWED_ORIGINS=http://localhost:3000

# //* LOGGING — WINSTON DAILY-ROTATE-FILE (SEE src/shared/logger)
# LOG_LEVEL=debug
# LOG_DIR=logs
# LOG_MAX_SIZE=20m
# LOG_RETENTION_DAYS=14
# LOG_CONSOLE_ENABLED=true
# LOG_FILE_ENABLED=true
# LOG_ERROR_FILE_ENABLED=true
# LOG_JSON_CONSOLE=false

# //* JWT — GENERATE WITH: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace-me
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_SECRET=replace-me
JWT_REFRESH_EXPIRES_IN=30d
# //* 30 DAYS IN MILLISECONDS
JWT_REFRESH_EXPIRES_IN_MS=2592000000

# //* GOOGLE OAUTH — MUST MATCH THE FRONTEND'S GOOGLE CLIENT ID (OPTIONAL)
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# //* MAIL (SMTP)
MAIL_DRIVER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM=no-reply@example.com

# //* SEED — PASSWORDS FOR prisma/seed.ts. ROTATE AFTER FIRST LOGIN.
SEED_SUPER_ADMIN_PASSWORD=
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=

# //* RATE LIMITING — SEE docs/concepts/rate-limiting.md
# //* NUMBER OF REVERSE PROXIES IN FRONT OF THE APP (0 FOR LOCAL / DIRECT EXPOSURE)
THROTTLE_TRUST_PROXY_HOPS=0
THROTTLE_ENABLED=true
# THROTTLE_SHORT_TTL_MS=10000
# THROTTLE_SHORT_LIMIT=30
# THROTTLE_LONG_TTL_MS=60000
# THROTTLE_LONG_LIMIT=200

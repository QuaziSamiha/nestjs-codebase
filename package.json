{
  "name": "nestjs-starter-server",
  "version": "0.0.1",
  "engines": {
    "node": ">=20.19.0 <21.0.0"
  },
  "description": "Generalized NestJS + Prisma backend starter: auth, users, blog, pagination, file storage, logging, error handling, rate limiting",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "start": "node dist/main",
    "start:dev": "node node_modules/dotenv-cli/cli.js -e .env.development -- nest start --watch",
    "start:local": "node node_modules/dotenv-cli/cli.js -e .env.development.local -- nest start --watch",
    "start:office": "node node_modules/dotenv-cli/cli.js -e .env.office -- nest start --watch",
    "start:prod": "node node_modules/dotenv-cli/cli.js -e .env.production -- nest start --watch",
    "start:debug": "nest start --debug --watch",
    "generate": "node node_modules/dotenv-cli/cli.js -e .env.development -- prisma generate",
    "generate:local": "node node_modules/dotenv-cli/cli.js -e .env.development.local -- prisma generate",
    "generate:office": "node node_modules/dotenv-cli/cli.js -e .env.office -- prisma generate",
    "generate:prod": "node node_modules/dotenv-cli/cli.js -e .env.production -- prisma generate",
    "db:migrate": "node node_modules/dotenv-cli/cli.js -e .env.development -- prisma migrate dev",
    "db:migrate:local": "node node_modules/dotenv-cli/cli.js -e .env.development.local -- prisma migrate dev",
    "db:deploy": "node node_modules/dotenv-cli/cli.js -e .env.development -- prisma migrate deploy",
    "db:deploy:local": "node node_modules/dotenv-cli/cli.js -e .env.development.local -- prisma migrate deploy",
    "db:deploy:office": "node node_modules/dotenv-cli/cli.js -e .env.office -- prisma migrate deploy",
    "db:deploy:prod": "node node_modules/dotenv-cli/cli.js -e .env.production -- prisma migrate deploy",
    "studio": "node node_modules/dotenv-cli/cli.js -e .env.development -- prisma studio",
    "studio:local": "node node_modules/dotenv-cli/cli.js -e .env.development.local -- prisma studio",
    "studio:office": "node node_modules/dotenv-cli/cli.js -e .env.office -- prisma studio",
    "studio:prod": "node node_modules/dotenv-cli/cli.js -e .env.production -- prisma studio",
    "db:seed": "node node_modules/dotenv-cli/cli.js -e .env.development -- tsx prisma/seed.ts",
    "db:seed:local": "node node_modules/dotenv-cli/cli.js -e .env.development.local -- tsx prisma/seed.ts",
    "db:seed:office": "node node_modules/dotenv-cli/cli.js -e .env.office -- tsx prisma/seed.ts",
    "db:seed:prod": "node node_modules/dotenv-cli/cli.js -e .env.production -- tsx prisma/seed.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@nestjs-modules/mailer": "^2.3.4",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/swagger": "^11.2.7",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "google-auth-library": "^10.9.1",
    "handlebars": "^4.7.9",
    "jsonwebtoken": "^9.0.3",
    "nest-winston": "^1.10.2",
    "nodemailer": "^8.0.5",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "3.22.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^8.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.2",
    "dotenv": "^17.4.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "^7.7.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}

//* ─────────────────────────────────────────────────────────────────────────
//* RATE LIMITING — SEE src/common/throttler AND docs/concepts/rate-limiting.md
//*
//* THROTTLE_TRUST_PROXY_HOPS DECIDES WHAT req.ip RESOLVES TO, AND req.ip IS THE
//* RATE-LIMIT BUCKET KEY FOR EVERY UNAUTHENTICATED CALLER. IT MUST BE SET
//* EXPLICITLY IN EVERY DEPLOYED ENVIRONMENT: THE SCHEMA DEFAULT IS 0, AND 0
//* BEHIND A PROXY MEANS EVERY CALLER PRESENTS AS THE PROXY'S OWN IP AND THE
//* ENTIRE INTERNET SHARES ONE BUCKET — 30 REQUESTS PER 10s FOR ALL OF PRODUCTION.
//*
//* 1 = THE nginx/1.24.0 (Ubuntu) THAT TERMINATES TLS FOR
//* https://api.thpwellness.com AND FORWARDS TO THIS PROCESS ON PORT 4054.
//* NOTHING ELSE IS IN THE PATH: THE HOSTNAME IS A SINGLE A RECORD TO THE ORIGIN
//* HOST, RESPONSES CARRY NO cf-ray (SO NO CLOUDFLARE) AND THE RECORD IS NOT A
//* CLOUD LOAD-BALANCER CNAME. RAISE THIS ONLY WHEN A REAL HOP IS ADDED IN FRONT
//* OF nginx — PUTTING CLOUDFLARE ON THE DOMAIN WOULD MAKE IT 2.
//*
//* OVER-COUNTING IS THE WORSE MISTAKE OF THE TWO. X-Forwarded-For IS
//* CLIENT-CONTROLLED, SO TRUSTING MORE HOPS THAN PHYSICALLY EXIST LETS A CALLER
//* SPOOF A FRESH IP PER REQUEST AND WALK STRAIGHT PAST THE LIMITER. NEVER `true`.
//*
//* THIS ONLY WORKS IF nginx ACTUALLY SENDS THE HEADER:
//*   proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
//*   proxy_set_header X-Forwarded-Proto $scheme;
//* IF IT DOESN'T, AppThrottlerGuard SAYS SO ON THE FIRST REQUEST IT SEES —
//* THE HOP COUNT CANNOT BE VALIDATED FROM A DEV MACHINE, SO IT IS VERIFIED
//* AGAINST REAL TRAFFIC INSTEAD. GREP THE LOGS AFTER DEPLOY.
//* ─────────────────────────────────────────────────────────────────────────
THROTTLE_TRUST_PROXY_HOPS=1

//* EMERGENCY KILL SWITCH — SET false AND RESTART TO DISABLE RATE LIMITING ON
//* EVERY ROUTE. HELD EXPLICIT, NOT LEFT TO A ZOD DEFAULT, SO IT IS FINDABLE
//* DURING AN INCIDENT INSTEAD OF BEING LOOKED UP IN THE SOURCE.
THROTTLE_ENABLED=true

//* GLOBAL TIERS — AT THE SCHEMA DEFAULTS IN src/common/throttler/config/throttler.env.ts.
//* UNCOMMENT TO RETUNE. PER-ROUTE LIMITS (LOGIN, SIGNUP, OTP, PASSWORD RESET) ARE
//* DELIBERATELY *NOT* ENV-DRIVEN — SEE THE COMMENT IN throttler.constants.ts.
# THROTTLE_SHORT_TTL_MS=10000
# THROTTLE_SHORT_LIMIT=30
# THROTTLE_LONG_TTL_MS=60000
# THROTTLE_LONG_LIMIT=200
